lar，数据类型需要可转换成self与other推导后的数据类型。\n[L36]  * @param [in] out: npu\n[L37]  * device侧的aclTensor，数据类型支持整型，浮点类型，且数据类型需要是self与other推导之后可转换的数据类型，shape需要是self与other\n[L38]  * broadcast之后的shape，数据格式支持ND，且数据格式需要与self一致。\n[L39]  * @param [out] workspaceSize: 返回用户需要在npu device侧申请的workspace大小。\n[L40]  * @param [out] executor: 返回op执行器，包含算子计算流程。\n[L41]  * @return aclnnStatus: 返回状态码。\n[L42]  */\n[L43] ACLNN_API aclnnStatus aclnnAddGetWorkspaceSize(\n[L44]     const aclTensor* self, const aclTensor* other, const aclScalar* alpha, aclTensor* out, uint64_t* workspaceSize,\n[L45]     aclOpExecutor** executor);\n[L46] \n[L47] /**\n[L48]  * @brief aclnnAdd的第二段接口，用于执行计算。\n[L49]  *\n[L50]  * 算子功能：完成加法计算\n[L51]  * 计算公式：\n[L52]  * $$ output_i = self_i+alpha*other_i $$\n[L53]  *\n[L54]  * @param [in] workspace: 在npu device侧申请的workspace内存起址。\n[L55]  * @param [in] workspace_size: 在npu device侧申请的workspace大小，由第一段接口aclnnAddGetWorkspaceSize获取。\n[L56]  * @param [in] executor: op执行器，包含了算子计算流程。\n[L57]  * @param [in] stream: acl stream流。\n[L58]  * @return aclnnStatus: 返回状态码。\n[L59]  */\n[L60] ACLNN_API aclnnStatus aclnnAdd(void* workspace, uint64_t workspaceSize, aclOpExecutor* executor, aclrtStream stream);\n[L61] \n[L62] /**\n[L63]  * @brief aclnnAdds的第一段接口，根据具体的计算流程，计算workspace大小。\n[L64]  * @domain aclnn_math\n[L65]  */\n[L66] ACLNN_API aclnnStatus aclnnAddsGetWorkspaceSize(\n[L67]     const aclTensor* self, const aclScalar* other, const aclScalar* alpha, aclTensor* out, uint64_t* workspaceSize,\n[L68]     aclOpExecutor** executor);\n[L69] ACLNN_API aclnnStatus aclnnAdds(void* workspace, uint64_t workspaceSize, aclOpExecutor* executor, aclrtStream stream);\n[L70] \n[L71] /**\n[L72]  * @brief aclnnInplaceAdd的第一段接口，根据具体的计算流程，计算workspace大小。\n[L73]  * @domain aclnn_math\n[L74]  *\n[L75]  * 算子功能：完成加法计算\n[L76]  * 计算公式：\n[L77]  * $$ output_i = self_i+alpha*other_i $$\n[L78]  *\n[L79]  * @param [in] self: npu\n[L80]  * device侧的aclTensor，数据类型支持整型，浮点类型，且数据类型需要与other构成互相推导关系，shape需要与other满足broadcast关系。\n[L81]  * 支持非连续的Tensor，数据格式支持ND，且数据格式需要与other一致。\n[L82]  * @param [in] other: npu\n[L83]  * device侧的aclTensor，数据类型支持整型，浮点类型，且数据类型需要与self构成互相推导关系，shape需要与self满足broadcast关系。\n[L84]  * 支持非连续的Tensor，数据格式支持ND，且数据格式需要与self一致。\n[L85]  * @param [in] alpha: host侧的aclScalar，数据类型需要可转换成self与other推导后的数据类型。\n[L86]  * @param [out] workspaceSize: 返回用户需要在npu device侧申请的workspace大小。\n[L87]  * @param [out] executor: 返回op执行器，包含了算子计算流程。\n[L88]  * @return aclnnStatus: 返回状态码。\n[L89]  */\n[L90] ACLNN_API aclnnStatus aclnnInplaceAddGetWorkspaceSize(\n[L91]     const aclTensor* selfRef, const aclTensor* other, const aclScalar* alpha, uint64_t* workspaceSize,\n[L92]     aclOpExecutor** executor);\n[L93] \n[L94] /**\n[L95]  * @brief aclnnInplaceAdd的第二段接口，用于执行计算。\n[L96]  *\n[L97]  * 算子功能：完成加法计算\n[L98]  * 计算公式：\n[L99]  * $$ output_i = self_i+alpha*other_i $$\n[L100]  *\n[L101]  * @param [in] workspace: 在npu device侧申请的workspace内存起址。\n[L102]  * @param [in] workspaceSize: 在npu device侧申请的workspace大小，由第一段接口aclnnInplaceAddGetWorkspaceSize获取。\n[L103]  * @param [in] executor: op执行器，包含了算子计算流程。\n[L104]  * @param [in] stream: acl stream流。\n[L105]  * @return aclnnStatus: 返回状态码。\n[L106]  */\n[L107] ACLNN_API aclnnStatus\n[L108] aclnnInplaceAdd(void* workspace, uint64_t workspaceSize, aclOpExecutor* executor, aclrtStream stream);\n[L109] \n[L110] /**\n[L111]  * @brief aclnnInplaceAdds的第一段接口，根据具体的计算流程，计算workspace大小。\n[L112]  * @domain aclnn_math\n[L113]  */\n[L114] ACLNN_API aclnnStatus aclnnInplaceAddsGetWorkspaceSize(\n[L115]     const aclTensor* selfRef, const aclScalar* other, const aclScalar* alpha, uint64_t* workspaceSize,\n[L116]     aclOpExecutor** executor);\n[L117] \n[L118] ACLNN_API aclnnStatus\n[L119] aclnnInplaceAdds(void* workspace, uint64_t workspaceSize, aclOpExecutor* executor, aclrtStream stream);\n[L120] \n[L121] #ifdef __cplusplus\n[L122] }\n[L123] #endif\n[L124] \n[L125] #endif // OP_API_INC_ADD_H_", "role": "user"}], "model": "deepseek-flash", "temperature": 0}